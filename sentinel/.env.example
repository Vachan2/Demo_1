# Sentinel environment — copy to .env and fill in values

# Detection thresholds
ERROR_RATE_THRESHOLD_PCT=5.0
LATENCY_P95_THRESHOLD_MS=2000.0
DB_POOL_UTILISATION_THRESHOLD_PCT=80.0

# LLM (optional — falls back to rule-based RCA if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# GitHub (optional — falls back to local git if empty)
GITHUB_TOKEN=
GITHUB_REPO=your-org/order-service
GITHUB_BASE_BRANCH=main

# Order API location (for load tests / verification)
ORDER_API_URL=http://localhost:9000

# Path to the local order-service repo (relative to sentinel/)
LOCAL_REPO_PATH=../demo/order-service
